      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"storage_locations\" (\"id\" TEXT NOT NULL, \"home_id\" TEXT NOT NULL REFERENCES homes (id), \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "products",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"products\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"image_path\" TEXT NULL, \"energy_kcal\" REAL NULL, \"fat\" REAL NULL, \"saturated_fat\" REAL NULL, \"carbohydrates\" REAL NULL, \"sugars\" REAL NULL, \"protein\" REAL NULL, \"salt\" REAL NULL, \"barcode\" TEXT NULL, PRIMARY KEY (\"id\"));"
