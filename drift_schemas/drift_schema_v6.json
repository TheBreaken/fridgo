      ]
    },
    {
      "name": "stock_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"stock_items\" (\"id\" TEXT NOT NULL, \"product_id\" TEXT NOT NULL REFERENCES products (id), \"storage_location_id\" TEXT NOT NULL REFERENCES storage_locations (id), \"quantity\" REAL NOT NULL, \"unit\" TEXT NOT NULL, \"best_before_date\" TEXT NULL, \"opened_date\" TEXT NULL, PRIMARY KEY (\"id\"));"
